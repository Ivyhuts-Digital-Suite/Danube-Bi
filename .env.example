# Copy to .env.local and adjust. Never commit .env.local.

# Local MongoDB (Windows service "MongoDB" listens on 127.0.0.1:27017 by default):
MONGODB_URI=mongodb://127.0.0.1:27017/danube_bi
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/danube?retryWrites=true&w=majority

# Optional: where source files live (default: ./data). PDFs go in <DATA_DIR>/incoming,
# DLD CSV exports in <DATA_DIR>/incoming/dld.
# DATA_DIR=./data

# Optional: maximum DLD CSV upload size in MB through the web UI (default 200).
# Keep next.config.ts experimental.serverActions.bodySizeLimit in step if you raise it.
# MAX_UPLOAD_MB=200
